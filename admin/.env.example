# Campus to Career - Mentor & Admin Portal Environment Variables

# Backend API URL (must include /api if API routes are prefixed with /api)
# Local development:
VITE_API_URL=http://localhost:5000/api

# Production example (hosted on Railway / Render / VPS / Vercel Serverless):
# VITE_API_URL=https://api.yourdomain.com/api

# Student Web Application URL (for cross-navigation)
# Local development:
VITE_STUDENT_APP_URL=http://localhost:5173

# Production example:
# VITE_STUDENT_APP_URL=https://campus-to-career.vercel.app

# Google OAuth 2.0 Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=
